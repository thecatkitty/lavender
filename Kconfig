mainmenu "Lavender slideshow player features"


rsource "config/Kconfig.$(TARGET)"


config MODULES
    bool
    help
        Loadable module support.

config HAVE_INTERNET
    bool
    help
        Target platform supports Web services.

config TESTS
    bool "Build tests"
    default y if LINUX
    help
        Build automatic tests.

config ARD
    bool "Build AutoRun Dependency checker"
    default n
    depends on WINDOWS
    help
        Build the AutoRun utility for verifying and installing runtime
        prerequisities under Windows.


rsource "src/Kconfig"
